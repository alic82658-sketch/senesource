---
/**
 * Bandeau inversé (§4.9) : fond --ink, phrase en Newsreader --paper,
 * action mono en --ochre-inv (seul usage de l'ocre inversé).
 * Sert de pied d'appel (« Une information à faire vérifier ? DÉPOSER → »)
 * et de navigation de fin de page (§5.4).
 */
interface Props {
  texte: string;
  action: string; // « DÉPOSER → »
  href?: string;
}
const { texte, action, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class="bandeau" href={href}>
  <span class="bandeau-texte">{texte}</span>
  <span class="bandeau-action">{action}</span>
</Tag>

<style>
  .bandeau {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 20px;
    background: var(--ss-ink);
    color: var(--ss-paper);
  }
  .bandeau-texte {
    font: 400 14px/1.2 var(--ss-font-serif);
  }
  .bandeau-action {
    font: 500 10px/1 var(--ss-font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ss-ochre-inv);
    white-space: nowrap;
  }
  a.bandeau:hover .bandeau-action {
    opacity: 0.85;
  }
</style>
