---
/**
 * Image documentaire d'un dossier — rendu unique, réutilisé partout.
 *
 * Réutilise EXCLUSIVEMENT le modèle de domaine `Illustration`
 * (packages/domain/src/dossier.ts ; spec docs/architecture/14-illustrations-spec.md).
 * Une seule saisie éditoriale sert : la grande image de la page dossier, le
 * visuel « À la une » de la homepage et les cartes — avec un simple cadrage
 * responsive par point focal. Aucun second système d'image.
 *
 * La photo est documentaire : `alt` est obligatoire, et la légende/crédit/
 * droits/source sont du texte (jamais l'image seule porteuse de l'information).
 * Règles design system : zéro radius, zéro ombre, zéro gradient. Le seul filet
 * est un filet fin `--rule` séparant la légende de l'image.
 *
 * Le composant NE rend RIEN si `src` est absent : c'est l'appelant qui décide
 * du fallback texte — jamais de case grise, jamais de placeholder ici.
 */
interface Props {
  src?: string;
  alt?: string;
  largeur?: number;
  hauteur?: number;
  focal?: { x: number; y: number };
  legende?: string;
  credit?: string;
  sourceUrl?: string;
  droits?: string;
  ratio?: string; // ex. "16 / 9", "3 / 2", "4 / 3"
  avecLegende?: boolean; // rend la légende/crédit/source sous l'image
  class?: string;
}

const {
  src,
  alt = '',
  largeur,
  hauteur,
  focal,
  legende,
  credit,
  sourceUrl,
  droits,
  ratio = '3 / 2',
  avecLegende = false,
  class: klass,
} = Astro.props;

// Point focal → object-position (défaut centré). Normalisé 0–1 côté domaine.
const objPos = focal
  ? `${Math.round(focal.x * 100)}% ${Math.round(focal.y * 100)}%`
  : '50% 50%';

const aLegende = avecLegende && Boolean(legende || credit || droits || sourceUrl);
const credLigne = [credit, droits].filter(Boolean).join(' · ');
---

{
  src && (
    <figure class:list={['img', klass]}>
      <div class="img-cadre" style={`aspect-ratio: ${ratio};`}>
        <img
          class="img-el"
          src={src}
          alt={alt}
          width={largeur}
          height={hauteur}
          style={`object-position: ${objPos};`}
          loading="lazy"
          decoding="async"
        />
      </div>
      {aLegende && (
        <figcaption class="img-legende">
          {legende && <span class="img-texte">{legende}</span>}
          {credLigne && <span class="img-credit">{credLigne}</span>}
          {sourceUrl && (
            <a class="img-source" href={sourceUrl} target="_blank" rel="noopener noreferrer">
              Voir l’original →
            </a>
          )}
        </figcaption>
      )}
    </figure>
  )
}

<style>
  .img {
    margin: 0;
  }
  /* object-fit: cover + point focal : recadrage responsive sans déformation.
     Zéro radius, zéro ombre. Le ratio est piloté par l'appelant. */
  .img-cadre {
    overflow: hidden;
  }
  .img-el {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* object-position : point focal (inline) */
  }
  .img-legende {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-top: 9px;
    padding-top: 9px;
    border-top: 1px solid var(--ss-rule); /* filet fin — même niveau */
  }
  .img-texte {
    font: 400 12.5px/1.5 var(--ss-font-sans);
    color: var(--ss-ink-60);
    text-wrap: pretty;
  }
  .img-credit {
    font: 400 9.5px/1.5 var(--ss-font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ss-mid);
  }
  .img-source {
    align-self: start;
    margin-top: 3px;
    font: 500 9.5px/1 var(--ss-font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ss-ochre);
  }
  .img-source:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  @media (min-width: 1024px) {
    .img-texte {
      font-size: 13px;
    }
  }
</style>
