---
/**
 * Carte de dossier — grille éditoriale de la homepage.
 *
 * L'image (facultative) réutilise le MÊME champ `Illustration` du dossier
 * (aucun second système d'image, aucune duplication de métadonnées) via
 * ImageDossier, avec cadrage responsive par point focal. Sans image, la carte
 * se recompose proprement en version texte — jamais de case grise, jamais de
 * placeholder, jamais d'icône photo.
 *
 * Titre en Public Sans (contenu de carte) ; verdict en Newsreader ; méta en
 * mono. Zéro ombre, zéro radius : ce sont les images qui donnent la couleur.
 */
import ImageDossier from './ImageDossier.astro';
import type { Verdict } from './BlocVerdict.astro';

interface Illu {
  src?: string;
  alt?: string;
  focal?: { x: number; y: number };
  largeur?: number;
  hauteur?: number;
}
interface Props {
  numero: string;
  rubrique: string;
  type?: string;
  titre: string;
  href?: string;
  verdict?: Verdict | null;
  statutLibelle?: string;
  meta?: string;
  illustration?: Illu;
}
const {
  numero,
  rubrique,
  type,
  titre,
  href,
  verdict = null,
  statutLibelle,
  meta,
  illustration,
} = Astro.props;
const surligne = type ? `${rubrique} · ${type}` : rubrique;
---

<article class="carte">
  {
    illustration?.src && (
      <a class="carte-media" href={href} tabindex="-1" aria-hidden="true">
        <ImageDossier
          src={illustration.src}
          alt={illustration.alt}
          focal={illustration.focal}
          largeur={illustration.largeur}
          hauteur={illustration.hauteur}
          ratio="3 / 2"
        />
      </a>
    )
  }
  <div class="carte-corps">
    <p class="carte-meta">
      <span class="carte-numero">Dossier {numero}</span>
      <span class="carte-rubrique">{surligne}</span>
    </p>
    <h3 class="carte-titre">
      {href ? <a class="lien-titre" href={href}>{titre}</a> : titre}
    </h3>
    <div class="carte-bas">
      {
        verdict ? (
          <span class="carte-verdict">
            <span class="carte-verdict-label">Verdict</span>
            <span class="carte-verdict-mot">{verdict}</span>
          </span>
        ) : (
          statutLibelle && <span class="carte-statut">{statutLibelle}</span>
        )
      }
      {meta && <span class="carte-piecemeta">{meta}</span>}
    </div>
  </div>
</article>

<style>
  .carte {
    display: flex;
    flex-direction: column;
  }
  .carte-media {
    display: block;
  }
  .carte-media:hover {
    opacity: 0.94;
  }
  .carte-corps {
    padding-top: 12px;
  }
  /* Sans image, la carte reste structurée par un filet fin en tête. */
  .carte:not(:has(.carte-media)) .carte-corps {
    border-top: 1px solid var(--ss-ink);
    padding-top: 12px;
  }
  .carte-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    align-items: baseline;
    margin: 0 0 8px;
  }
  .carte-numero {
    font: 600 10px/1 var(--ss-font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ss-ochre);
    white-space: nowrap;
  }
  .carte-rubrique {
    font: 400 10px/1 var(--ss-font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ss-mid);
  }
  /* Titre de carte : Public Sans (contenu de carte), lisible et contemporain. */
  .carte-titre {
    margin: 0 0 12px;
    font: 600 18px/1.28 var(--ss-font-sans);
    letter-spacing: -0.005em;
    color: var(--ss-ink);
    text-wrap: pretty;
  }
  .carte-bas {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 12px;
    padding-top: 10px;
    border-top: 1px solid var(--ss-rule);
  }
  .carte-verdict {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
  }
  .carte-verdict-label {
    font: 500 9px/1 var(--ss-font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ss-mid);
    white-space: nowrap;
  }
  .carte-verdict-mot {
    font: 400 16px/1 var(--ss-font-serif);
    font-style: italic;
    color: var(--ss-ink);
  }
  .carte-statut {
    font: 400 15px/1 var(--ss-font-serif);
    font-style: italic;
    color: var(--ss-mid);
  }
  .carte-piecemeta {
    font: 400 9.5px/1.3 var(--ss-font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ss-mid);
    white-space: nowrap;
  }
  @media (min-width: 1024px) {
    .carte-titre {
      font-size: 19px;
    }
  }
</style>
