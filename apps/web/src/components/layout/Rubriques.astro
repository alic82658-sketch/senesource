---
import { RUBRIQUES } from '../../lib/rubriques';
interface Props { courante?: string; }
const { courante = '' } = Astro.props;
---

<nav class="rubriques" aria-label="Rubriques">
  <div class="rubriques-fondu" aria-hidden="true"></div>
  <div class="rubriques-interieur">
    {RUBRIQUES.map((rubrique) => (
      <a
        class:list={['rubrique-lien', { 'rubrique-lien--courante': courante === rubrique.slug }]}
        href={`/rubrique/${rubrique.slug}/`}
        aria-current={courante === rubrique.slug ? 'page' : undefined}
      >{rubrique.nom}</a>
    ))}
  </div>
</nav>

<style>
  .rubriques {
    position: relative;
    border-bottom: 1px solid var(--ss-ink);
    background: var(--ss-paper);
  }
  .rubriques-interieur {
    display: flex;
    gap: 22px;
    width: 100%;
    padding: 11px 20px 12px;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }
  .rubriques-interieur::-webkit-scrollbar { display: none; }
  .rubriques-fondu {
    position: absolute;
    z-index: 2;
    right: 0;
    top: 0;
    bottom: 1px;
    width: 34px;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, var(--ss-paper));
  }
  .rubrique-lien {
    flex: 0 0 auto;
    scroll-snap-align: start;
    font: 600 9.5px/1 var(--ss-font-mono);
    letter-spacing: .075em;
    text-transform: uppercase;
    color: var(--ss-mid);
    white-space: nowrap;
  }
  .rubrique-lien:hover,
  .rubrique-lien--courante { color: var(--ss-ink); }
  .rubrique-lien--courante {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  @media (min-width: 1024px) {
    .rubriques-fondu { display: none; }
    .rubriques-interieur {
      justify-content: center;
      gap: 28px;
      padding: 11px 48px;
      overflow: visible;
    }
    .rubrique-lien { font-size: 10px; }
  }
</style>
