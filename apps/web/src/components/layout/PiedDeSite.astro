---
/**
 * Pied de site — présent à la fin de chaque page publique.
 * Compose le bloc de politique de correction citoyenne puis affiche
 * discrètement l’identité monochrome S¹ et sa signature.
 * Le slogan n'apparaît qu'ici (jamais dans l'en-tête mobile, pour ne pas
 * le surcharger). Aucun radius / ombre / gradient ; aucun JS client.
 *
 * `contenu` (opt-in) : « centre » aligne le pied sur le MÊME conteneur centré
 * que le corps d'une page centrée (page dossier) — bloc de correction en
 * largeur de lecture centrée, marque sur la largeur utile. Par défaut
 * (« pleine »), le rendu est INCHANGÉ (pleine largeur) : les autres pages
 * (méthode) ne bougent pas.
 */
import PolitiqueCorrection from '../editorial/PolitiqueCorrection.astro';
import MarqueSeneSource from './MarqueSeneSource.astro';

interface Props {
  contenu?: 'pleine' | 'centre';
}
const { contenu = 'pleine' } = Astro.props;
const centre = contenu === 'centre';
---

<footer class:list={['pied-site', { 'pied-site--centre': centre }]}>
  <PolitiqueCorrection centre={centre} />
  <div class="pied-bas">
    <MarqueSeneSource format="pied" />
    <nav class="pied-liens" aria-label="Informations">
      <a class="pied-contact" href="/qui-sommes-nous">Qui sommes-nous</a>
      <a class="pied-contact" href="/mentions-legales">Mentions légales</a>
      <a class="pied-contact" href="mailto:contact@senesource.com">
        contact@senesource.com
      </a>
    </nav>
  </div>
</footer>

<style>
  .pied-bas {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 14px;
    padding: 14px 20px 24px;
    border-top: 1px solid var(--ss-rule); /* filet fin : même niveau */
  }

  /* Groupe de liens texte du pied — réutilise le style de lien existant. */
  .pied-liens {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
  }

  .pied-contact {
    font: 500 10px/1.4 var(--ss-font-mono);
    letter-spacing: 0.06em;
    color: var(--ss-ink-60);
  }
  .pied-contact:hover {
    color: var(--ss-ochre);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  @media (min-width: 1024px) {
    .pied-bas {
      padding: 16px 48px 28px;
      gap: 6px 18px;
    }
  }
  @media (min-width: 1440px) {
    .pied-bas {
      padding-left: 64px;
      padding-right: 64px;
    }
  }

  /* Variante centrée (opt-in, page dossier) : le pied appartient au conteneur
     centré du dossier (mêmes bornes que `.dossier`). La marque garde ses
     gouttières via `.pied-bas` ; le bloc de correction est centré en largeur
     de lecture (voir PolitiqueCorrection.correction--centre). */
  .pied-site--centre {
    max-width: 1180px;
    margin-inline: auto;
  }
  @media (min-width: 1440px) {
    .pied-site--centre {
      max-width: 1240px;
    }
  }
</style>
