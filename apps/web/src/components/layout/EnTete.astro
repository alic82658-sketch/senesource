---
import Rubriques from './Rubriques.astro';
import MarqueSeneSource from './MarqueSeneSource.astro';

interface Props {
  meta?: string;
  rubriqueCourante?: string;
  afficherRubriques?: boolean;
}
const { meta = '', rubriqueCourante = '', afficherRubriques = true } = Astro.props;
---

<header class="entete">
  <div class="entete-haut">
    <MarqueSeneSource />
    <div class="entete-actions">
      {meta && <span class="entete-meta">{meta}</span>}
      <a class="methode" href="/methode">Méthode</a>
    </div>
  </div>
  {afficherRubriques && <Rubriques courante={rubriqueCourante} />}
</header>

<style>
  .entete {
    background: var(--ss-paper);
  }
  .entete-haut {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 20px 12px;
    border-bottom: 1px solid color-mix(in srgb, var(--ss-ink) 16%, transparent);
  }
  .entete-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .entete-meta,
  .methode {
    font: 500 9px/1 var(--ss-font-mono);
    letter-spacing: .08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .entete-meta { color: var(--ss-mid); }
  .methode { color: var(--ss-ink); }
  .methode:hover { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 430px) {
    .entete-meta { display: none; }
  }
  @media (min-width: 1024px) {
    .entete-haut { padding: 17px 48px 14px; }
  }
  @media (min-width: 1440px) {
    .entete-haut { padding-left: 64px; padding-right: 64px; }
  }
</style>
