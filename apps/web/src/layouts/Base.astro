---
import '../styles/globals.css';

interface Props {
  titre: string;
  description?: string;
  noindex?: boolean;
  /**
   * Directive `robots` explicite (ex. « noindex, follow »). Prioritaire sur
   * `noindex`. Permet aux rubriques vides de rester suivies (follow) tout en
   * n'étant pas indexées.
   */
  robots?: string;
  /** URL canonique (chemin ou absolu). Par défaut : l'URL de la page courante. */
  canonical?: string;
}

const { titre, description, noindex = false, robots, canonical } = Astro.props;

// `noindex` conserve son comportement historique (noindex, nofollow) ; une
// directive `robots` explicite la remplace quand elle est fournie.
const robotsContent = robots ?? (noindex ? 'noindex, nofollow' : undefined);

// La marque n'est suffixée que si le titre de la page ne la contient pas déjà.
// Évite le doublon « … — SeneSource — SeneSource » quand une page (l'accueil)
// porte déjà « SeneSource » dans son titre. Règle valable pour toutes les pages.
const MARQUE = 'SeneSource';
const titreComplet = titre.includes(MARQUE) ? titre : `${titre} — ${MARQUE}`;

// Lien canonique — signal d'indexation, invisible. Résolu en absolu sur le
// domaine du site (astro.config.mjs `site`). Une page peut le surcharger
// (ex. /dossier/* pointe vers sa version /article/* pour éviter le doublon).
const canonicalURL = new URL(canonical ?? Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    {description && <meta name="description" content={description} />}
    {robotsContent && <meta name="robots" content={robotsContent} />}
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/newsreader-normal-400-500-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/newsreader-italic-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/public-sans-normal-400-600-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-normal-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- Données structurées et métadonnées propres à la page (JSON-LD…). -->
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
