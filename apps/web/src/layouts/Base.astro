---
import '../styles/globals.css';

interface Props {
  titre: string;
  description?: string;
  noindex?: boolean;
}

const { titre, description, noindex = false } = Astro.props;

// La marque n'est suffixée que si le titre de la page ne la contient pas déjà.
// Évite le doublon « … — SeneSource — SeneSource » quand une page (l'accueil)
// porte déjà « SeneSource » dans son titre. Règle valable pour toutes les pages.
const MARQUE = 'SeneSource';
const titreComplet = titre.includes(MARQUE) ? titre : `${titre} — ${MARQUE}`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/newsreader-normal-400-500-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/newsreader-italic-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/public-sans-normal-400-600-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-normal-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <slot />
  </body>
</html>
