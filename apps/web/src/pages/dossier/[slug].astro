---
import Base from '../../layouts/Base.astro';
import CitationAffirmation from '../../components/editorial/CitationAffirmation.astro';
import CitationOfficielle from '../../components/editorial/CitationOfficielle.astro';
import ModuleConsequences from '../../components/editorial/ModuleConsequences.astro';
import LignePreuve from '../../components/editorial/LignePreuve.astro';
import EncartNote from '../../components/editorial/EncartNote.astro';
import ImageDossier from '../../components/editorial/ImageDossier.astro';
import Jauge from '../../components/ui/Jauge.astro';
import Carre from '../../components/ui/Carre.astro';
import PiedDeSite from '../../components/layout/PiedDeSite.astro';
import {
  dossiersAvecPage,
  collecte,
  numeroAffiche,
  fines,
  segmentsRenvois,
  dateJourMois,
  dateComplete,
  type Dossier,
} from '../../lib/contenu';

export async function getStaticPaths() {
  return (await dossiersAvecPage()).map((d) => ({ params: { slug: d.slug }, props: { dossier: d } }));
}

interface Props {
  dossier: Dossier;
}
const { dossier } = Astro.props;
const d = dossier;
const num = numeroAffiche(d.numero);
const j = collecte(dossier);
const preuvesMobiles = d.preuves.filter((p) => p.mobile);
const etablies = d.preuves.filter((p) => p.etabli);
const nonEtablies = d.preuves.filter((p) => !p.etabli);
const consequence = d.consequenceDossier;
const illustration = d.illustration;
const metaLigne = `Dossier ${num} · ${d.rubrique}`;
const description = d.verdict
  ? `${d.affirmation?.texte ?? d.titre} — Verdict : ${d.verdict.mot}. ${d.resume ?? ''}`.trim()
  : `${d.titre} Dossier en instruction : ${j.obtenues} pièces obtenues sur ${j.total}.`;
---

<Base titre={`Dossier ${num} — ${d.titre}`} description={description}>
  <article class="dossier">
    <!-- Barre de navigation fine (retour + statut de collecte) -->
    <div class="barre">
      <a class="barre-retour" href="/">← Tous les dossiers</a>
      <span class="barre-meta">
        {
          d.version
            ? `Version ${d.version} · ${d.misAJourLe ? `Mise à jour le ${dateComplete(d.misAJourLe)}` : ''} · ${j.total} pièces`
            : d.ouvertLe
              ? `Ouvert le ${dateJourMois(d.ouvertLe)} · ${j.total} pièces`
              : `${j.total} pièces`
        }
      </span>
    </div>

    <!-- A + B — métadonnées discrètes puis grand titre éditorial -->
    <header class="tete">
      <p class="tete-meta">{metaLigne}</p>
      <h1 class="tete-titre">{d.titre}</h1>
    </header>

    <!-- C + D — grande illustration horizontale + légende/crédit/source -->
    {
      illustration && (
        <div class="media">
          <ImageDossier
            src={illustration.src}
            alt={illustration.alt}
            largeur={illustration.largeur}
            hauteur={illustration.hauteur}
            focal={illustration.focal}
            legende={illustration.legende}
            credit={illustration.credit}
            sourceUrl={illustration.sourceUrl}
            droits={illustration.droits}
            ratio="16 / 9"
            avecLegende
          />
        </div>
      )
    }

    <div class="corps">
      <!-- ===== Colonne principale : E → H ===== -->
      <div class="principal">
        <!-- E — affirmation vérifiée + verdict -->
        {
          d.affirmation && (
            <section class="affirmation">
              <span class="typo-label">
                {d.verdict ? "L'affirmation vérifiée" : "L'affirmation en cours de vérification"}
              </span>
              <div class="affirmation-citation">
                <CitationAffirmation
                  texte={d.affirmation.texte}
                  provenance={d.affirmation.provenance}
                  provenanceLongue={d.affirmation.provenanceLongue}
                  grande
                />
              </div>
            </section>
          )
        }

        <section class="verdict">
          {
            d.verdict ? (
              <>
                <div class="verdict-ligne">
                  <span class="verdict-etiquette">Verdict</span>
                  <span class="typo-verdict typo-verdict-grand">{d.verdict.mot}</span>
                </div>
                {d.verdict.resumeCourt && <p class="verdict-punch">{d.verdict.resumeCourt}</p>}
              </>
            ) : (
              <>
                <div class="verdict-ligne">
                  <span class="verdict-etiquette">En instruction</span>
                  <span class="sans-verdict">Pas encore de verdict</span>
                </div>
                {d.instruction && <p class="verdict-punch">{d.instruction.explication}</p>}
                <div class="verdict-jauge">
                  <Jauge
                    obtenues={j.obtenues}
                    total={j.total}
                    libelle={`${j.obtenues} / ${j.total}${d.instruction ? ` · Prochain point le ${dateJourMois(d.instruction.prochainPoint)}` : ''}`}
                    largeurBarre={16}
                  />
                </div>
              </>
            )
          }
        </section>

        <!-- F — résumé (sourcé) -->
        {
          d.verdict && (
            <section class="resume">
              <span class="typo-label">Le résumé</span>
              <p class="resume-texte">
                {segmentsRenvois(d.verdict.resume).map((s) =>
                  s.type === 'renvoi' ? <span class="souligne-ocre">{s.valeur}</span> : s.valeur,
                )}
              </p>
            </section>
          )
        }

        <!-- G — preuves (mobile : liste ; desktop : deux colonnes) -->
        {
          preuvesMobiles.length > 0 && (
            <section class="preuves-mobile">
              <span class="typo-label">
                {d.verdict ? 'Ce qui est établi, et par quoi' : 'Ce que nous savons déjà'}
              </span>
              <div class="preuves-liste">
                {preuvesMobiles.map((p, i) => (
                  <LignePreuve
                    texte={p.texte}
                    etabli={p.etabli}
                    meta={p.meta ?? ''}
                    derniere={i === preuvesMobiles.length - 1}
                  />
                ))}
              </div>
              <div class="preuves-jauge">
                <Jauge
                  obtenues={j.obtenues}
                  total={j.total}
                  libelle={`${j.obtenues} obtenues · ${j.total - j.obtenues} manquantes`}
                />
              </div>
            </section>
          )
        }
        {
          d.preuves.length > 0 && (
            <section class="preuves-desktop">
              <div>
                <span class="typo-label">Ce qui est établi</span>
                <div class="colonne-liste">
                  {etablies.map((p) => (
                    <div class="colonne-item">
                      <Carre etat="plein" taille={7} decale />
                      <span class="colonne-texte">{p.texteCourt ?? p.texte}</span>
                    </div>
                  ))}
                </div>
              </div>
              <div class="colonne-non">
                <span class="typo-label">Ce qui n'est pas établi</span>
                <div class="colonne-liste">
                  {nonEtablies.map((p) => (
                    <div class="colonne-item">
                      <Carre etat="vide" taille={7} decale />
                      <span class="colonne-texte colonne-texte--non">{p.texteCourt ?? p.texte}</span>
                    </div>
                  ))}
                  {d.nonEtabliMeta && <div class="colonne-meta">{d.nonEtabliMeta}</div>}
                </div>
              </div>
            </section>
          )
        }

        <!-- Texte officiel (§4.7) — quand présent -->
        {
          d.texteOfficiel && (
            <section class="officiel">
              <span class="typo-label">Ce que dit le texte officiel</span>
              <div class="officiel-bloc officiel-bloc--mobile">
                <CitationOfficielle
                  texte={d.texteOfficiel.texteCourt ?? d.texteOfficiel.texte}
                  cote={d.texteOfficiel.cote}
                  action={d.texteOfficiel.actionCourte ?? d.texteOfficiel.action}
                  href="#pieces"
                />
              </div>
              <div class="officiel-bloc officiel-bloc--desktop">
                <CitationOfficielle
                  texte={d.texteOfficiel.texte}
                  cote={d.texteOfficiel.cote}
                  action={d.texteOfficiel.action}
                  href="#pieces"
                />
              </div>
            </section>
          )
        }

        <!-- H — conséquences -->
        {
          consequence ? (
            <section class="consequences">
              <ModuleConsequences
                profil={consequence.profil}
                chiffre={fines(consequence.chiffre)}
                qualification={fines(consequence.qualification)}
                qualificationDesktop={
                  consequence.qualificationDesktop && fines(consequence.qualificationDesktop)
                }
                hypothese={consequence.hypothese && fines(consequence.hypothese)}
                action="Voir les autres profils →"
              />
            </section>
          ) : (
            d.encartAbsence && (
              <section class="consequences">
                <EncartNote label={d.encartAbsence.label} texte={d.encartAbsence.texte} />
              </section>
            )
          )
        }
      </div>

      <!-- ===== Rail latéral : I → J ===== -->
      <aside class="rail">
        <!-- I — sources / pièces, toujours accessibles -->
        {
          d.pieces.length > 0 && (
            <div id="pieces" class="rail-bloc">
              <span class="typo-label">Les {j.total} pièces</span>
              <div class="rail-pieces">
                {d.pieces.map((p, i) => (
                  <div class:list={['rail-piece-item', { 'rail-piece-item--manquante': !p.obtenue, 'rail-piece-item--fin': i === d.pieces.length - 1 }]}>
                    <div class="rail-piece">
                      <span class="rail-n">[{p.n}]</span>
                      <span class="rail-titre">{p.titreCourt ?? p.titre}</span>
                      <Carre etat={p.obtenue ? 'plein' : 'vide'} taille={7} decale />
                    </div>
                    {p.url && (
                      <a class="rail-source" href={p.url} target="_blank" rel="noopener noreferrer">
                        Ouvrir la source →
                      </a>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )
        }

        <!-- J — historique de publication -->
        {
          d.historique.length > 0 && (
            <div class="rail-bloc">
              <span class="typo-label">Historique de publication</span>
              <ol class="rail-historique">
                {d.historique.map((h) => (
                  <li class="rail-histo-entree">
                    <span class="rail-histo-repere">V{h.version} · {dateComplete(h.date)}</span>
                    <span class="rail-histo-note">{h.note}</span>
                  </li>
                ))}
              </ol>
            </div>
          )
        }

        <div class="rail-erreur">
          Une erreur dans ce dossier&nbsp;? <span class="rail-erreur-lien">Signalez-la</span> — nous
          republions en version datée.
        </div>
      </aside>
    </div>
  </article>

  <PiedDeSite contenu="centre" />
</Base>

<style>
  /* Conteneur éditorial centré — média numérique, pas pleine largeur brute. */
  .dossier {
    width: 100%;
    max-width: 1180px;
    margin-inline: auto;
    padding: 0 20px;
  }

  /* ---- Barre fine ---- */
  .barre {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--ss-rule);
  }
  .barre-retour {
    font: 500 10px/1 var(--ss-font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ss-ink);
    white-space: nowrap;
  }
  .barre-meta {
    font: 400 10px/1 var(--ss-font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ss-mid);
    text-align: right;
  }

  /* ---- A + B — méta + grand titre ---- */
  .tete {
    padding: 22px 0 0;
  }
  .tete-meta {
    margin: 0;
    font: 500 10px/1.4 var(--ss-font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ss-ochre);
  }
  .tete-titre {
    margin: 10px 0 0;
    font: 400 28px/1.14 var(--ss-font-serif);
    letter-spacing: -0.015em;
    color: var(--ss-ink);
    text-wrap: balance;
  }

  /* ---- C + D — grande image ---- */
  .media {
    margin-top: 18px;
  }

  /* ---- Corps ---- */
  .corps {
    padding: 22px 0 8px;
  }
  .principal {
    min-width: 0;
  }

  /* E — affirmation + verdict */
  .affirmation-citation {
    margin-top: 10px;
  }
  .verdict {
    margin-top: 20px;
    border-top: 1px solid var(--ss-ink);
    padding-top: 14px;
  }
  .verdict-ligne {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .verdict-etiquette {
    font: 500 9px/1 var(--ss-font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ss-mid);
    white-space: nowrap;
  }
  .sans-verdict {
    font: 400 24px/1.1 var(--ss-font-serif);
    color: var(--ss-mid);
  }
  .verdict-punch {
    margin: 12px 0 0;
    font: 400 16px/1.55 var(--ss-font-sans);
    color: var(--ss-ink-90);
    text-wrap: pretty;
  }
  .verdict-jauge {
    margin-top: 12px;
  }

  /* F — résumé */
  .resume {
    margin-top: 20px;
    padding-top: 14px;
    border-top: 1px solid var(--ss-rule);
  }
  .resume-texte {
    margin: 10px 0 0;
    font: 400 15.5px/1.65 var(--ss-font-sans);
    color: var(--ss-ink-80);
    text-wrap: pretty;
  }

  /* G — preuves */
  .preuves-mobile {
    margin-top: 20px;
    padding-top: 14px;
    border-top: 1px solid var(--ss-rule);
  }
  .preuves-liste {
    margin-top: 12px;
  }
  .preuves-jauge {
    margin-top: 12px;
  }
  .preuves-desktop {
    display: none;
  }

  /* Texte officiel */
  .officiel {
    margin-top: 20px;
    padding-top: 14px;
    border-top: 1px solid var(--ss-rule);
  }
  .officiel-bloc {
    margin-top: 10px;
  }
  .officiel-bloc--desktop {
    display: none;
  }

  /* H — conséquences */
  .consequences {
    margin-top: 22px;
  }

  /* ---- Rail (mobile : flux normal) ---- */
  .rail {
    margin-top: 24px;
  }
  .rail-bloc {
    margin-top: 22px;
    padding-top: 14px;
    border-top: 1px solid var(--ss-rule);
  }
  .rail-bloc:first-child {
    margin-top: 0;
  }
  .rail-pieces {
    margin-top: 12px;
  }
  .rail-piece-item {
    padding: 9px 0;
    border-top: 1px solid var(--ss-rule);
  }
  .rail-piece-item:first-child {
    border-top: 0;
  }
  .rail-piece-item--fin {
    border-bottom: 1px solid var(--ss-rule);
  }
  .rail-piece {
    display: flex;
    gap: 10px;
    align-items: baseline;
  }
  .rail-n {
    font: 500 10px/1.5 var(--ss-font-mono);
    color: var(--ss-ochre);
  }
  .rail-piece-item--manquante .rail-n {
    color: var(--ss-mid);
    font-weight: 400;
  }
  .rail-titre {
    font: 400 13.5px/1.45 var(--ss-font-sans);
    flex: 1;
  }
  .rail-piece-item--manquante .rail-titre {
    color: var(--ss-mid);
    font-style: italic;
  }
  .rail-source {
    display: inline-block;
    margin-top: 6px;
    font: 500 9.5px/1 var(--ss-font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ss-ochre);
  }
  .rail-source:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .rail-historique {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .rail-histo-entree {
    padding: 9px 0;
    border-top: 1px solid var(--ss-rule);
  }
  .rail-histo-entree:first-child {
    border-top: 0;
  }
  .rail-histo-repere {
    display: block;
    font: 400 10px/1.5 var(--ss-font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ss-ochre);
  }
  .rail-histo-note {
    display: block;
    margin-top: 4px;
    font: 400 13px/1.5 var(--ss-font-sans);
    color: var(--ss-ink-80);
    text-wrap: pretty;
  }
  .rail-erreur {
    margin-top: 22px;
    padding-top: 14px;
    border-top: 1px solid var(--ss-rule);
    font: 400 12.5px/1.6 var(--ss-font-sans);
    color: var(--ss-ink-60);
  }
  .rail-erreur-lien {
    color: var(--ss-ochre);
  }

  /* =============== ≥768 — le titre respire =============== */
  @media (min-width: 768px) {
    .dossier {
      padding: 0 40px;
    }
    .tete-titre {
      font-size: 40px;
      line-height: 1.08;
      max-width: 20ch;
    }
  }

  /* =============== ≥1024 — corps en deux colonnes (rail latéral) =============== */
  @media (min-width: 1024px) {
    .dossier {
      padding: 0 48px;
    }
    .barre {
      padding: 16px 0;
    }
    .tete {
      padding-top: 30px;
    }
    .tete-titre {
      font-size: 48px;
      max-width: 24ch;
    }
    .media {
      margin-top: 22px;
    }

    .corps {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 300px;
      column-gap: 56px;
      align-items: start;
      padding-top: 28px;
    }
    /* La colonne de lecture garde une largeur confortable. */
    .principal {
      max-width: 760px;
    }

    /* E */
    .verdict {
      margin-top: 24px;
    }
    .verdict-etiquette {
      font-size: 9.5px;
    }
    .verdict-punch {
      font-size: 18px;
      line-height: 1.55;
    }
    /* F */
    .resume-texte {
      font-size: 17px;
      line-height: 1.7;
    }

    /* G — deux colonnes établi / non établi */
    .preuves-mobile {
      display: none;
    }
    .preuves-desktop {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      margin-top: 24px;
      padding-top: 16px;
      border-top: 1px solid var(--ss-rule);
    }
    .colonne-liste {
      margin-top: 12px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .colonne-item {
      display: flex;
      gap: 10px;
      align-items: flex-start;
    }
    .colonne-texte {
      font: 400 14px/1.5 var(--ss-font-sans);
      color: var(--ss-ink);
      flex: 1;
    }
    .colonne-texte--non {
      color: var(--ss-mid);
      font-style: italic;
    }
    .colonne-meta {
      font: 400 10px/1.5 var(--ss-font-mono);
      text-transform: uppercase;
      color: var(--ss-mid);
    }

    /* Texte officiel */
    .officiel-bloc--mobile {
      display: none;
    }
    .officiel-bloc--desktop {
      display: block;
    }

    /* Rail latéral, aligné au sommet du corps */
    .rail {
      margin-top: 0;
      display: flex;
      flex-direction: column;
      gap: 0;
      padding-left: 28px;
      border-left: 1px solid var(--ss-rule);
    }
    .rail-bloc:first-child {
      margin-top: 0;
      padding-top: 0;
      border-top: 0;
    }
  }

  /* =============== ≥1440 — marges élargies =============== */
  @media (min-width: 1440px) {
    .dossier {
      padding: 0 64px;
      max-width: 1240px;
    }
  }
</style>
