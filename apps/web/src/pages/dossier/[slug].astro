---
import Base from '../../layouts/Base.astro';
import CitationAffirmation from '../../components/editorial/CitationAffirmation.astro';
import CitationOfficielle from '../../components/editorial/CitationOfficielle.astro';
import ModuleConsequences from '../../components/editorial/ModuleConsequences.astro';
import LignePreuve from '../../components/editorial/LignePreuve.astro';
import EncartNote from '../../components/editorial/EncartNote.astro';
import IllustrationDossier from '../../components/editorial/IllustrationDossier.astro';
import Jauge from '../../components/ui/Jauge.astro';
import Carre from '../../components/ui/Carre.astro';
import PiedDeSite from '../../components/layout/PiedDeSite.astro';
import {
  dossiersAvecPage,
  collecte,
  numeroAffiche,
  fines,
  segmentsRenvois,
  dateJourMois,
  dateComplete,
  type Dossier,
} from '../../lib/contenu';

export async function getStaticPaths() {
  return (await dossiersAvecPage()).map((d) => ({ params: { slug: d.slug }, props: { dossier: d } }));
}

interface Props {
  dossier: Dossier;
}
const { dossier } = Astro.props;
const d = dossier;
const num = numeroAffiche(d.numero);
const j = collecte(dossier);
const rubriquePrincipale = d.rubrique.split('·')[0]!.trim();
const preuvesMobiles = d.preuves.filter((p) => p.mobile);
const etablies = d.preuves.filter((p) => p.etabli);
const nonEtablies = d.preuves.filter((p) => !p.etabli);
const consequence = d.consequenceDossier;
// L'illustration principale est FACULTATIVE : présente, elle ouvre une vraie
// colonne média dans le hero desktop ; absente, le layout se reconfigure
// automatiquement en deux colonnes (contenu + sources), sans zone vide.
const illustration = d.illustration;
const avecImage = Boolean(illustration);
const description = d.verdict
  ? `${d.affirmation?.texte ?? d.titre} — Verdict : ${d.verdict.mot}. ${d.resume ?? ''}`.trim()
  : `${d.titre} Dossier en instruction : ${j.obtenues} pièces obtenues sur ${j.total}.`;
---

<Base titre={`Dossier ${num} — ${d.titre}`} description={description}>
  <div class:list={['dossier', { 'dossier--avec-image': avecImage }]}>
    <!-- Barre de retour (§5.2 / §6.2) -->
    <div class="barre">
      <a class="barre-retour" href="/">← Dossier {num}<span class="barre-rubrique"> · {rubriquePrincipale}</span></a>
      <span class="barre-meta">
        <span class="barre-meta-mobile">
          {d.version ? `v${d.version} · ${d.misAJourLe ? dateComplete(d.misAJourLe) : ''}` : d.ouvertLe ? `Ouvert le ${dateJourMois(d.ouvertLe)}` : ''}
        </span>
        <span class="barre-meta-desktop">
          {
            d.version
              ? `Version ${d.version} · Mise à jour le ${d.misAJourLe ? dateComplete(d.misAJourLe) : ''} · ${j.total} pièces`
              : d.ouvertLe
                ? `Ouvert le ${dateJourMois(d.ouvertLe)} · ${j.total} pièces`
                : `${j.total} pièces`
          }
        </span>
      </span>
    </div>

    <div class="corps">
      <!-- ===== MÉDIA — illustration principale (hero desktop / haut mobile) ===== -->
      {
        illustration && (
          <div class="dossier-media">
            <IllustrationDossier
              src={illustration.src}
              alt={illustration.alt}
              largeur={illustration.largeur}
              hauteur={illustration.hauteur}
              focal={illustration.focal}
              legende={illustration.legende}
              credit={illustration.credit}
              sourceUrl={illustration.sourceUrl}
              droits={illustration.droits}
            />
          </div>
        )
      }

      <!-- ===== INTRO ÉDITORIALE — affirmation + verdict (hero, colonne gauche) ===== -->
      <section class="dossier-intro">
        {
          d.affirmation && (
            <div class="affirmation">
              <span class="typo-label">
                {d.verdict ? "L'affirmation vérifiée" : "L'affirmation en cours de vérification"}
              </span>
              <div class="affirmation-citation">
                <CitationAffirmation
                  texte={d.affirmation.texte}
                  provenance={d.affirmation.provenance}
                  provenanceLongue={d.affirmation.provenanceLongue}
                  grande
                />
              </div>
            </div>
          )
        }

        <!-- Bloc verdict / en instruction (§4.1 / §4.2) -->
        <div class="verdict">
          {
            d.verdict ? (
              <>
                <div class="verdict-ligne">
                  <span class="verdict-etiquette">Verdict</span>
                  <span class="typo-verdict typo-verdict-grand">{d.verdict.mot}</span>
                </div>
                {d.verdict.resumeCourt && (
                  <p class="verdict-resume verdict-resume--mobile">{d.verdict.resumeCourt}</p>
                )}
                <p
                  class:list={[
                    'verdict-resume',
                    { 'verdict-resume--desktop': !!d.verdict.resumeCourt },
                  ]}
                >
                  {segmentsRenvois(d.verdict.resume).map((s) =>
                    s.type === 'renvoi' ? <span class="souligne-ocre">{s.valeur}</span> : s.valeur,
                  )}
                </p>
              </>
            ) : (
              <>
                <div class="verdict-ligne">
                  <span class="verdict-etiquette">En instruction</span>
                  <span class="sans-verdict">Pas encore de verdict</span>
                </div>
                {d.instruction && <p class="verdict-resume">{d.instruction.explication}</p>}
                <div class="verdict-jauge">
                  <Jauge
                    obtenues={j.obtenues}
                    total={j.total}
                    libelle={`${j.obtenues} / ${j.total}${d.instruction ? ` · Prochain point le ${dateJourMois(d.instruction.prochainPoint)}` : ''}`}
                    largeurBarre={16}
                  />
                </div>
              </>
            )
          }
        </div>
      </section>

      <!-- ===== SUITE — preuves, texte officiel, conséquences, sources, historique ===== -->
      <div class="dossier-suite">
        <!-- Preuves — gabarit mobile (§5.2) : liste unique avec cotes -->
        {
          preuvesMobiles.length > 0 && (
            <section class="preuves-mobile">
              <span class="typo-label">
                {d.verdict ? 'Ce qui est établi, et par quoi' : 'Ce que nous savons déjà'}
              </span>
              <div class="preuves-liste">
                {preuvesMobiles.map((p, i) => (
                  <LignePreuve
                    texte={p.texte}
                    etabli={p.etabli}
                    meta={p.meta ?? ''}
                    derniere={i === preuvesMobiles.length - 1}
                  />
                ))}
              </div>
              <div class="preuves-jauge">
                <Jauge
                  obtenues={j.obtenues}
                  total={j.total}
                  libelle={`${j.obtenues} obtenues · ${j.total - j.obtenues} manquantes`}
                />
              </div>
            </section>
          )
        }

        <!-- Preuves — gabarit desktop (§6.2) : deux colonnes -->
        {
          d.preuves.length > 0 && (
            <section class="preuves-desktop">
              <div>
                <span class="typo-label">Ce qui est établi</span>
                <div class="colonne-liste">
                  {etablies.map((p) => (
                    <div class="colonne-item">
                      <Carre etat="plein" taille={7} decale />
                      <span class="colonne-texte">{p.texteCourt ?? p.texte}</span>
                    </div>
                  ))}
                </div>
              </div>
              <div class="colonne-non">
                <span class="typo-label">Ce qui n'est pas établi</span>
                <div class="colonne-liste">
                  {nonEtablies.map((p) => (
                    <div class="colonne-item">
                      <Carre etat="vide" taille={7} decale />
                      <span class="colonne-texte colonne-texte--non">{p.texteCourt ?? p.texte}</span>
                    </div>
                  ))}
                  {d.nonEtabliMeta && <div class="colonne-meta">{d.nonEtabliMeta}</div>}
                </div>
              </div>
            </section>
          )
        }

        <!-- Texte officiel (§4.7) -->
        {
          d.texteOfficiel && (
            <section class="officiel">
              <span class="typo-label">
                <span class="officiel-label-mobile">Le texte officiel</span>
                <span class="officiel-label-desktop">Ce que dit le texte officiel</span>
              </span>
              <div class="officiel-bloc officiel-bloc--mobile">
                <CitationOfficielle
                  texte={d.texteOfficiel.texteCourt ?? d.texteOfficiel.texte}
                  cote={d.texteOfficiel.cote}
                  action={d.texteOfficiel.actionCourte ?? d.texteOfficiel.action}
                  href="#pieces"
                />
              </div>
              <div class="officiel-bloc officiel-bloc--desktop">
                <CitationOfficielle
                  texte={d.texteOfficiel.texte}
                  cote={d.texteOfficiel.cote}
                  action={d.texteOfficiel.action}
                  href="#pieces"
                />
              </div>
            </section>
          )
        }

        <!-- Conséquences — flux mobile (§5.2) / encart absent (§7) -->
        {
          consequence ? (
            <div class="module-mobile">
              <ModuleConsequences
                profil={consequence.profil}
                chiffre={fines(consequence.chiffre)}
                qualification={fines(consequence.qualification)}
                hypothese={consequence.hypothese && fines(consequence.hypothese)}
              />
            </div>
          ) : (
            d.encartAbsence && (
              <div class="module-mobile">
                <EncartNote label={d.encartAbsence.label} texte={d.encartAbsence.texte} />
              </div>
            )
          )
        }

        <!-- Sources en accès direct — mobile (le rail les porte en desktop) -->
        {
          d.pieces.some((p) => p.url) && (
            <section class="sources-mobile">
              <span class="typo-label">Les sources, en accès direct</span>
              <ul class="sources-liste">
                {d.pieces
                  .filter((p) => p.url)
                  .map((p) => (
                    <li class="source-item">
                      <span class="source-titre">{p.titre}</span>
                      <a class="source-lien" href={p.url} target="_blank" rel="noopener noreferrer">
                        Ouvrir la source →
                      </a>
                    </li>
                  ))}
              </ul>
            </section>
          )
        }

        <!-- Historique de publication — mobile (rail sur desktop) -->
        {
          d.historique.length > 0 && (
            <section class="historique-mobile">
              <span class="typo-label">Historique de publication</span>
              <ol class="historique-liste">
                {d.historique.map((h) => (
                  <li class="historique-entree">
                    <span class="historique-repere">V{h.version} · {dateComplete(h.date)}</span>
                    <span class="historique-note">{h.note}</span>
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        <!-- Pied mobile (§5.2 / §5.3) -->
        <div class="pied-mobile">
          <span class="pied-mobile-texte">
            {d.verdict ? `Voir les ${j.total} pièces du dossier` : 'Être prévenu de la conclusion'}
          </span>
          <span class="pied-mobile-fleche">→</span>
        </div>
      </div>

      <!-- ===== RAIL SOURCES (desktop, §6.2) ===== -->
      <aside class="rail">
        {
          consequence ? (
            <ModuleConsequences
              profil={consequence.profil}
              chiffre={fines(consequence.chiffre)}
              qualification={fines(consequence.qualification)}
              qualificationDesktop={
                consequence.qualificationDesktop && fines(consequence.qualificationDesktop)
              }
              hypothese={consequence.hypothese && fines(consequence.hypothese)}
              action="Voir les autres profils →"
            />
          ) : (
            d.encartAbsence && <EncartNote label={d.encartAbsence.label} texte={d.encartAbsence.texte} />
          )
        }
        {
          d.pieces.length > 0 && (
            <div id="pieces">
              <span class="typo-label">Les {j.total} pièces</span>
              <div class="rail-pieces">
                {d.pieces.map((p, i) => (
                  <div class:list={['rail-piece-item', { 'rail-piece-item--manquante': !p.obtenue, 'rail-piece-item--fin': i === d.pieces.length - 1 }]}>
                    <div class="rail-piece">
                      <span class="rail-n">[{p.n}]</span>
                      <span class="rail-titre">{p.titreCourt ?? p.titre}</span>
                      <Carre etat={p.obtenue ? 'plein' : 'vide'} taille={7} decale />
                    </div>
                    {p.url && (
                      <a class="rail-source" href={p.url} target="_blank" rel="noopener noreferrer">
                        Ouvrir la source →
                      </a>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )
        }
        {
          d.historique.length > 0 && (
            <div>
              <span class="typo-label">Historique de publication</span>
              <div class="rail-historique">
                {d.historique.map((h) => (
                  <>
                    V{h.version} · {dateComplete(h.date)} — {h.note}
                    <br />
                  </>
                ))}
              </div>
            </div>
          )
        }
        <div class="rail-erreur">
          Une erreur dans ce dossier&nbsp;? <span class="rail-erreur-lien">Signalez-la</span> — nous
          republions en version datée.
        </div>
      </aside>
    </div>
  </div>

  <PiedDeSite />
</Base>

<style>
  /* Conteneur éditorial centré (desktop) : borne la largeur pour éviter le grand
     vide des écrans larges. Mobile : pleine largeur, aucun effet. */
  .dossier {
    width: 100%;
  }

  /* ---- Barre de retour ---- */
  .barre {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--ss-ink);
  }
  .barre-retour {
    /* Mono allégé (moins d'interlettrage) pour un rendu numérique contemporain. */
    font: 500 10px/1 var(--ss-font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ss-ink);
    white-space: nowrap;
  }
  .barre-rubrique {
    display: none;
  }
  .barre-meta {
    font: 400 10px/1 var(--ss-font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ss-mid);
    white-space: nowrap;
  }
  .barre-meta-desktop {
    display: none;
  }

  /* ---- Média mobile : image pleine largeur de la colonne de contenu ---- */
  .dossier-media {
    padding: 18px 20px 0;
  }

  /* ---- Affirmation ---- */
  .affirmation {
    padding: 20px 20px 0;
  }
  .affirmation-citation {
    margin-top: 10px;
  }

  /* ---- Verdict ---- */
  .verdict {
    margin: 20px 20px 0;
    border-top: 1px solid var(--ss-ink);
    border-bottom: 1px solid var(--ss-rule);
    padding: 14px 0;
  }
  .verdict-ligne {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .verdict-etiquette {
    font: 500 9px/1 var(--ss-font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ss-mid);
    white-space: nowrap;
  }
  .sans-verdict {
    font: 400 24px/1.1 var(--ss-font-serif);
    color: var(--ss-mid);
  }
  .verdict-resume {
    margin: 12px 0 0;
    font: 400 15.5px/1.6 var(--ss-font-sans);
    color: var(--ss-ink-90);
    text-wrap: pretty;
  }
  .verdict-jauge {
    margin-top: 12px;
  }

  /* ---- Preuves mobile ---- */
  .preuves-mobile {
    padding: 18px 20px 0;
  }
  .preuves-liste {
    margin-top: 12px;
  }
  .preuves-jauge {
    margin-top: 12px;
  }
  .preuves-desktop {
    display: none;
  }

  /* ---- Texte officiel ---- */
  .officiel {
    padding: 18px 20px 0;
  }
  .officiel-bloc {
    margin-top: 10px;
  }
  .officiel-label-desktop,
  .officiel-bloc--desktop,
  .verdict-resume--desktop {
    display: none;
  }

  /* ---- Conséquences / pied mobile ---- */
  .module-mobile {
    margin: 18px 20px;
  }
  .pied-mobile {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 14px 20px;
    border-top: 1px solid var(--ss-ink);
  }
  .pied-mobile-texte {
    font: 400 13.5px/1.2 var(--ss-font-serif);
  }
  .pied-mobile-fleche {
    font: 500 10px/1 var(--ss-font-mono);
    color: var(--ss-ochre);
  }

  /* ---- Sources en accès direct (mobile) ---- */
  .sources-mobile {
    padding: 18px 20px 0;
  }
  .sources-liste {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .source-item {
    padding: 10px 0;
    border-top: 1px solid var(--ss-rule);
  }
  .source-titre {
    display: block;
    font: 400 14px/1.45 var(--ss-font-sans);
    color: var(--ss-ink-80);
    text-wrap: pretty;
  }
  .source-lien {
    display: inline-block;
    margin-top: 6px;
    font: 500 9.5px/1 var(--ss-font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ss-ochre);
  }
  .source-lien:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  /* ---- Historique mobile ---- */
  .historique-mobile {
    padding: 18px 20px 0;
  }
  .historique-liste {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .historique-entree {
    padding: 9px 0;
    border-top: 1px solid var(--ss-rule);
  }
  .historique-repere {
    display: block;
    font: 400 10px/1.5 var(--ss-font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ss-ochre);
  }
  .historique-note {
    display: block;
    margin-top: 4px;
    font: 400 13.5px/1.5 var(--ss-font-sans);
    color: var(--ss-ink-80);
    text-wrap: pretty;
  }

  .rail {
    display: none;
  }

  /* =============== ≥1024 (§6.2) — conteneur centré + hero multi-colonnes =============== */
  @media (min-width: 1024px) {
    /* Conteneur éditorial centré. Avec image : large (hero 42/36/22).
       Sans image : plus resserré → deux colonnes contenu + sources, sans vide. */
    .dossier {
      max-width: 1160px;
      margin-inline: auto;
    }
    .dossier--avec-image {
      max-width: 1520px;
    }

    .barre {
      padding: 16px 48px;
    }
    .barre-retour,
    .barre-meta {
      font-size: 10.5px;
    }
    .barre-rubrique,
    .barre-meta-desktop {
      display: inline;
    }
    .barre-meta-mobile {
      display: none;
    }

    /* Grille du corps. Sans image : contenu + rail. */
    .corps {
      display: grid;
      align-items: start;
      column-gap: 44px;
      row-gap: 4px;
      padding: 34px 48px;
      grid-template-columns: minmax(0, 1fr) 320px;
      grid-template-areas:
        'intro rail'
        'suite rail';
    }
    /* Avec image : contenu 42 % · illustration 36 % · rail 22 %. */
    .dossier--avec-image .corps {
      grid-template-columns: 42fr 36fr 22fr;
      grid-template-areas:
        'intro media rail'
        'suite suite rail';
    }

    .dossier-media {
      grid-area: media;
      padding: 0;
    }
    .dossier-intro {
      grid-area: intro;
      min-width: 0;
    }
    .dossier-suite {
      grid-area: suite;
      min-width: 0;
      margin-top: 26px;
    }

    /* Intro : affirmation + verdict, sans les gouttières mobiles. */
    .affirmation {
      padding: 0;
    }
    .affirmation-citation {
      margin-top: 12px;
    }
    .verdict {
      margin: 22px 0 0;
      padding: 16px 0;
    }
    .verdict-etiquette {
      font-size: 9.5px;
    }
    /* Résumé (Public Sans) : davantage de place et d'air — lecture numérique. */
    .verdict-resume {
      margin-top: 14px;
      font-size: 17px;
      line-height: 1.7;
    }

    /* Preuves desktop : occupent la largeur de la suite (contenu + média). */
    .preuves-mobile {
      display: none;
    }
    .preuves-desktop {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
    }
    .colonne-liste {
      margin-top: 12px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .colonne-item {
      display: flex;
      gap: 10px;
      align-items: flex-start;
    }
    .colonne-texte {
      font: 400 14px/1.5 var(--ss-font-sans);
      color: var(--ss-ink);
      flex: 1;
    }
    .colonne-texte--non {
      color: var(--ss-mid);
      font-style: italic;
    }
    .colonne-meta {
      font: 400 10px/1.5 var(--ss-font-mono);
      text-transform: uppercase;
      color: var(--ss-mid);
    }

    .officiel {
      margin-top: 30px;
      padding: 22px 0 0;
      border-top: 1px solid var(--ss-ink);
      max-width: var(--ss-texte-max);
    }
    .officiel-bloc {
      margin-top: 12px;
    }
    .officiel-label-mobile,
    .officiel-bloc--mobile,
    .verdict-resume--mobile {
      display: none;
    }
    .officiel-label-desktop {
      display: inline;
    }
    .officiel-bloc--desktop {
      display: block;
    }
    .verdict-resume--desktop {
      display: block;
    }

    /* Blocs mobiles masqués en desktop (repris par le rail). */
    .module-mobile,
    .pied-mobile,
    .historique-mobile,
    .sources-mobile {
      display: none;
    }

    /* Rail sources : colonne continue, rapprochée du contenu par un filet fin. */
    .rail {
      grid-area: rail;
      display: flex;
      flex-direction: column;
      gap: 24px;
      border-left: 1px solid var(--ss-rule);
      padding-left: 28px;
    }
    .rail-pieces {
      margin-top: 12px;
    }
    .rail-piece-item {
      padding: 9px 0;
      border-top: 1px solid var(--ss-rule);
    }
    .rail-piece-item--fin {
      border-bottom: 1px solid var(--ss-rule);
    }
    .rail-piece {
      display: flex;
      gap: 10px;
      align-items: baseline;
    }
    .rail-n {
      font: 500 10px/1.5 var(--ss-font-mono);
      color: var(--ss-ochre);
    }
    .rail-piece-item--manquante .rail-n {
      color: var(--ss-mid);
      font-weight: 400;
    }
    .rail-titre {
      font: 400 13px/1.45 var(--ss-font-sans);
      flex: 1;
    }
    .rail-piece-item--manquante .rail-titre {
      color: var(--ss-mid);
      font-style: italic;
    }
    .rail-source {
      display: inline-block;
