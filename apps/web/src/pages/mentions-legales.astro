---
import Base from '../layouts/Base.astro';
import EnTete from '../components/layout/EnTete.astro';
import PiedDeSite from '../components/layout/PiedDeSite.astro';
import { AUTEUR, SITE_CONTACT } from '../lib/jsonld';

/**
 * /mentions-legales — informations légales de SeneSource.
 * Réutilise à l'identique le gabarit et les classes de /methode (même
 * structure, même feuille de style). Faits renseignés par l'éditeur ;
 * aucune donnée inventée.
 */
---

<Base
  titre="Mentions légales"
  description="Éditeur, directeur de la publication, hébergeur et contact de SeneSource."
>
  <EnTete />

  <main class="methode">
    <header class="methode-tete">
      <span class="typo-label">Informations légales</span>
      <h1 class="typo-display methode-titre">Mentions légales</h1>
      <p class="methode-intro">
        Informations relatives à l’éditeur du site, à la responsabilité de la publication et à
        l’hébergement, conformément aux obligations légales.
      </p>
    </header>

    <!-- A -->
    <section class="section">
      <span class="typo-label">A</span>
      <h2 class="section-titre">Éditeur du site</h2>
      <p class="section-texte">
        SeneSource, média numérique de vérification documentaire, est édité par {AUTEUR}, personne
        physique. Contact&nbsp;: <a href={`mailto:${SITE_CONTACT}`}>{SITE_CONTACT}</a>.
      </p>
    </section>

    <!-- B -->
    <section class="section">
      <span class="typo-label">B</span>
      <h2 class="section-titre">Directeur de la publication</h2>
      <p class="section-texte">{AUTEUR}.</p>
    </section>

    <!-- C -->
    <section class="section">
      <span class="typo-label">C</span>
      <h2 class="section-titre">Hébergeur</h2>
      <p class="section-texte">
        Cloudflare,&nbsp;Inc. — 101&nbsp;Townsend&nbsp;Street, San&nbsp;Francisco, CA&nbsp;94107,
        États-Unis. <a href="https://www.cloudflare.com" rel="noopener noreferrer">cloudflare.com</a>
      </p>
    </section>

    <!-- D -->
    <section class="section">
      <span class="typo-label">D</span>
      <h2 class="section-titre">Contact</h2>
      <p class="section-texte">
        Pour toute demande, correction ou droit de réponse&nbsp;:
        <a href={`mailto:${SITE_CONTACT}`}>{SITE_CONTACT}</a>.
      </p>
      <p class="section-texte section-texte--note">
        Voir aussi <a href="/qui-sommes-nous">qui nous sommes</a> et
        <a href="/methode">notre méthode</a>.
      </p>
    </section>
  </main>

  <PiedDeSite />
</Base>

<style>
  .methode {
    padding: 22px 20px 8px;
    max-width: var(--ss-texte-max);
  }

  /* ---- Tête ---- */
  .methode-titre {
    margin-top: 12px;
  }
  .methode-promesse {
    margin-top: 14px;
    font: 400 17px/1.4 var(--ss-font-serif);
    font-style: italic;
    color: var(--ss-ink);
  }
  .methode-intro {
    margin-top: 14px;
    font: 400 15.5px/1.62 var(--ss-font-sans);
    color: var(--ss-ink-80);
    max-width: var(--ss-corps-max);
    text-wrap: pretty;
  }

  /* ---- Sections ---- */
  .section {
    margin-top: 26px;
    padding-top: 20px;
    border-top: 1px solid var(--ss-ink); /* filet fort entre sections */
  }
  .section-titre {
    margin-top: 8px;
    font: 400 21px/1.25 var(--ss-font-serif);
    letter-spacing: -0.01em;
    color: var(--ss-ink);
  }
  .section-texte {
    margin-top: 12px;
    font: 400 15px/1.62 var(--ss-font-sans);
    color: var(--ss-ink-80);
    max-width: var(--ss-corps-max);
    text-wrap: pretty;
  }
  .section-texte--note {
    margin-top: 14px;
    color: var(--ss-ink-60);
  }

  /* ---- Listes ---- */
  .liste {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    max-width: var(--ss-corps-max);
  }
  .liste-item {
    position: relative;
    padding: 8px 0 8px 22px;
    border-top: 1px solid var(--ss-rule); /* filet fin : items d'un même niveau */
    font: 400 14.5px/1.5 var(--ss-font-sans);
    color: var(--ss-ink-80);
    counter-increment: liste;
  }
  /* Puce mono ocre — cohérente avec le renvoi [n] du design system */
  .liste-item::before {
    content: '—';
    position: absolute;
    left: 0;
    font: 400 12px/1.7 var(--ss-font-mono);
    color: var(--ss-ochre);
  }
  .liste--ordonnee {
    counter-reset: liste;
  }
  .liste--ordonnee .liste-item::before {
    content: counter(liste);
  }

  /* ---- Vocabulaire de la preuve (B) ---- */
  .etats {
    margin: 14px 0 0;
    max-width: var(--ss-corps-max);
  }
  .etat {
    padding: 10px 0;
    border-top: 1px solid var(--ss-rule);
  }
  .etat-mot {
    font: 500 10px/1 var(--ss-font-mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ss-ink);
  }
  .etat-sens {
    margin: 6px 0 0;
    font: 400 14.5px/1.5 var(--ss-font-sans);
    color: var(--ss-ink-60);
  }

  /* ---- Principe (D) ---- */
  .principe {
    margin-top: 12px;
    font: 400 22px/1.35 var(--ss-font-serif);
    font-style: italic;
    color: var(--ss-ink);
    max-width: 26ch;
  }

  /* =============== ≥1024 =============== */
  @media (min-width: 1024px) {
    .methode {
      padding: 34px 48px 12px;
    }
    .methode-promesse {
      font-size: 19px;
    }
    .methode-intro {
      font-size: 16.5px;
      line-height: 1.65;
    }
    .section {
      margin-top: 32px;
      padding-top: 24px;
    }
    .section-titre {
      font-size: 23px;
    }
    .section-texte {
      font-size: 16px;
      line-height: 1.65;
    }
    .liste-item {
      font-size: 15px;
    }
    .etat-sens {
      font-size: 15px;
    }
    .principe {
      font-size: 26px;
    }
  }
  @media (min-width: 1440px) {
    .methode {
      padding-left: 64px;
      padding-right: 64px;
    }
  }
</style>
