---
import Base from '../layouts/Base.astro';
import EnTete from '../components/layout/EnTete.astro';
import CarteDossier from '../components/editorial/CarteDossier.astro';
import BandeauInverse from '../components/editorial/BandeauInverse.astro';
import ImageDossier from '../components/editorial/ImageDossier.astro';
import PiedDeSite from '../components/layout/PiedDeSite.astro';
import { listeDossiers, collecte, numeroAffiche, dateJourMois, dateComplete } from '../lib/contenu';

const dossiers = await listeDossiers();
// Dossier à la une : le dossier complet le plus récent (ici, le 001).
const une = dossiers.find((d) => d.pageComplete) ?? dossiers[0]!;
// Les dossiers suivants alimentent la grille — numéro croissant. Vide
// aujourd'hui (seul le 001 est publié) : on n'invente aucun contenu.
const autres = dossiers.filter((d) => d.slug !== une.slug).sort((a, b) => a.numero - b.numero);

const jUne = collecte(une);
const urlUne = `/dossier/${une.slug}/`;
const uneResume = une.verdict?.resumeCourt ?? une.resume;
const uneDate = une.misAJourLe
  ? `Mis à jour le ${dateComplete(une.misAJourLe)}`
  : une.ouvertLe
    ? `Ouvert le ${dateJourMois(une.ouvertLe)}`
    : '';
const uneMeta = [`${jUne.total} pièces`, uneDate].filter(Boolean).join(' · ');
---

<Base
  titre="Vérifications, pièces et conséquences"
  description="SeneSource — média sénégalais de vérification documentaire : dossiers, verdicts, pièces et conséquences concrètes."
>
  <EnTete courante="verifications" meta="Sam. 22 août" />

  <main class="accueil">
    <!-- ===== A — À LA UNE ===== -->
    <section class:list={['une', { 'une--avec-image': !!une.illustration }]}>
      {
        une.illustration && (
          <a class="une-media" href={urlUne} aria-label={`Ouvrir le dossier : ${une.titre}`}>
            <ImageDossier
              src={une.illustration.src}
              alt={une.illustration.alt}
              focal={une.illustration.focal}
              largeur={une.illustration.largeur}
              hauteur={une.illustration.hauteur}
              ratio="3 / 2"
            />
          </a>
        )
      }
      <div class="une-corps">
        <p class="une-surtitre">
          <span class="une-numero">Dossier {numeroAffiche(une.numero)}</span>
          <span class="une-rubrique">{une.rubrique}</span>
          <span class="une-alaune">À la une</span>
        </p>
        <h1 class="une-titre">
          <a class="lien-titre" href={urlUne}>{une.titreCourt ?? une.titre}</a>
        </h1>
        <div class="une-verdict">
          {
            une.verdict ? (
              <>
                <span class="une-verdict-label">Verdict</span>
                <span class="une-verdict-mot">{une.verdict.mot}</span>
              </>
            ) : (
              <span class="une-verdict-label">En instruction</span>
            )
          }
        </div>
        {uneResume && <p class="une-resume">{uneResume}</p>}
        <div class="une-pied">
          <span class="une-pieces">{uneMeta}</span>
          <a class="une-lien" href={urlUne}>Lire le dossier →</a>
        </div>
      </div>
    </section>

    <!-- ===== B — GRILLE DES DOSSIERS SUIVANTS ===== -->
    {
      autres.length > 0 && (
        <section class="suite">
          <span class="typo-label suite-titre">Derniers dossiers</span>
          <div class="grille">
            {autres.map((d) => {
              const jd = collecte(d);
              return (
                <CarteDossier
                  numero={numeroAffiche(d.numero)}
                  rubrique={d.rubrique}
                  titre={d.titre}
                  href={d.pageComplete ? `/dossier/${d.slug}/` : undefined}
                  verdict={d.verdict?.mot ?? null}
                  statutLibelle={d.verdict ? undefined : 'En instruction'}
                  meta={d.verdict ? `${jd.total} pièces` : `${jd.obtenues} / ${jd.total} pièces`}
                  illustration={d.illustration}
                />
              );
            })}
          </div>
        </section>
      )
    }
  </main>

  <!-- Appel : faire vérifier une information -->
  <div class="accueil-cta">
    <BandeauInverse texte="Une information à faire vérifier ?" action="Déposer →" />
  </div>

  <PiedDeSite />
</Base>

<style>
  .accueil {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding: 20px 20px 8px;
  }

  /* ===== À la une — mobile : image puis bloc éditorial ===== */
  .une {
    display: flex;
    flex-direction: column;
  }
  .une-media {
    display: block;
    margin-bottom: 16px;
  }
  .une-media:hover {
    opacity: 0.96;
  }
  .une-surtitre {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
    margin: 0 0 12px;
  }
  .une-numero {
    font: 600 11px/1 var(--ss-font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ss-ochre);
    white-space: nowrap;
  }
  .une-rubrique {
    font: 400 11px/1 var(--ss-font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ss-mid);
  }
  .une-alaune {
    margin-left: auto;
    font: 500 9.5px/1 var(--ss-font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ss-ink);
  }
  /* Gros titre — Newsreader */
  .une-titre {
    margin: 0;
    font: 400 30px/1.1 var(--ss-font-serif);
    letter-spacing: -0.02em;
    color: var(--ss-ink);
    text-wrap: balance;
  }
  .une-verdict {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--ss-ink);
  }
  .une-verdict-label {
    font: 500 9.5px/1 var(--ss-font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ss-mid);
    white-space: nowrap;
  }
  .une-verdict-mot {
    font: 400 24px/1 var(--ss-font-serif);
    font-style: italic;
    color: var(--ss-ink);
  }
  /* Résumé très court — Public Sans */
  .une-resume {
    margin: 14px 0 0;
    font: 400 16px/1.6 var(--ss-font-sans);
    color: var(--ss-ink-80);
    text-wrap: pretty;
  }
  .une-pied {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
    margin-top: 16px;
  }
  .une-pieces {
    font: 400 10px/1.4 var(--ss-font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ss-mid);
  }
  .une-lien {
    font: 500 10px/1 var(--ss-font-mono);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ss-ochre);
    white-space: nowrap;
  }
  .une-lien:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  /* ===== Grille des dossiers suivants ===== */
  .suite {
    margin-top: 32px;
    padding-top: 18px;
    border-top: 1px solid var(--ss-ink);
  }
  .suite-titre {
    display: block;
    margin-bottom: 16px;
  }
  .grille {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }

  .accueil-cta {
    max-width: 1200px;
    margin: 28px auto 0;
  }

  /* ===== ≥640 — grille deux colonnes ===== */
  @media (min-width: 640px) {
    .grille {
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 32px 28px;
    }
  }

  /* ===== ≥1024 — À la une côte à côte ===== */
  @media (min-width: 1024px) {
    .accueil {
      padding: 28px 48px 8px;
    }
    .une--avec-image {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      column-gap: 44px;
      align-items: center;
    }
    .une--avec-image .une-media {
      margin-bottom: 0;
    }
    .une-titre {
      font-size: 44px;
      line-height: 1.05;
    }
    /* Sans image : le titre occupe une largeur de lecture, pas toute la page. */
    .une:not(.une--avec-image) .une-titre,
    .une:not(.une--avec-image) .une-resume {
      max-width: 34ch;
    }
    .une-verdict-mot {
      font-size: 28px;
    }
    .une-resume {
      font-size: 17px;
    }
    .suite {
      margin-top: 44px;
    }
    .accueil-cta {
      padding: 0 48px;
    }
  }

  @media (min-width: 1440px) {
    .accueil {
      padding-left: 64px;
      padding-right: 64px;
    }
    .accueil-cta {
      padding: 0 64px;
    }
  }
</style>
