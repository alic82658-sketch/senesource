---
import Base from '../layouts/Base.astro';
import EnTete from '../components/layout/EnTete.astro';
import ImageDossier from '../components/editorial/ImageDossier.astro';
import CarteDossier from '../components/editorial/CarteDossier.astro';
import MarqueSeneSource from '../components/layout/MarqueSeneSource.astro';
import { listeDossiers, collecte, dateComplete, numeroAffiche } from '../lib/contenu';
import { organisationEtSiteLD } from '../lib/jsonld';

// Données structurées de l'accueil (invisibles) : Organization + WebSite.
const jsonLd = organisationEtSiteLD(Astro.site!);

const dossiers = await listeDossiers();
const une = dossiers.find((d) => d.pageComplete) ?? dossiers[0]!;
const autres = dossiers.filter((d) => d.slug !== une.slug).sort((a, b) => b.numero - a.numero);
const jUne = collecte(une);
const urlUne = `/article/${une.slug}/`;
const uneResume = une.verdict?.resumeCourt ?? une.resume ?? '';
const uneDate = une.misAJourLe ? `Mis à jour le ${dateComplete(une.misAJourLe)}` : '';
const dateHeader = new Intl.DateTimeFormat('fr-FR', { weekday: 'short', day: 'numeric', month: 'long' }).format(new Date());
---

<Base
  titre="SeneSource — L’actualité qui vous instruit"
  description="SeneSource explique l’actualité sénégalaise à partir des faits, des documents et de leurs conséquences concrètes."
>
  <Fragment slot="head">
    {jsonLd.map((objet) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(objet)} />
    ))}
  </Fragment>

  <EnTete meta={dateHeader} />

  <main class="accueil">
    <section class="une" aria-labelledby="titre-une">
      <p class="section-label">À la une</p>

      {une.illustration && (
        <figure class="une-figure">
          <a class="une-media" href={urlUne} aria-label={`Lire l’analyse : ${une.titre}`}>
            <span class="une-categorie">{une.categorie}</span>
            <ImageDossier
              src={une.illustration.src}
              alt={une.illustration.alt}
              largeur={une.illustration.largeur}
              hauteur={une.illustration.hauteur}
              focal={une.illustration.focal ?? { x: .5, y: .5 }}
              ratio="2 / 1"
              ratioMobile="3 / 2"
            />
          </a>
          {(une.illustration.legende || une.illustration.credit) && (
            <figcaption>
              {une.illustration.legende ?? une.illustration.alt}
              {une.illustration.credit ? ` — ${une.illustration.credit}` : ''}
            </figcaption>
          )}
        </figure>
      )}

      <div class="une-corps">
        <h1 id="titre-une"><a href={urlUne}>{une.titreCourt ?? une.titre}</a></h1>
        {uneResume && <p class="une-resume">{uneResume}</p>}
        <div class="une-bas">
          <span>{[une.rubrique, uneDate, `${jUne.total} sources et pièces`].filter(Boolean).join(' · ')}</span>
          <a class="cta" href={urlUne}>Lire l’analyse →</a>
        </div>
      </div>
    </section>

    {autres.length > 0 && (
      <section class="suite" aria-labelledby="titre-suite">
        <div class="section-entete">
          <h2 id="titre-suite">À comprendre aujourd’hui</h2>
          <span>Les faits, puis ce qu’ils changent</span>
        </div>
        <div class="grille">
          {autres.map((d) => {
            const jd = collecte(d);
            return (
              <CarteDossier
                numero={numeroAffiche(d.numero)}
                rubrique={d.rubrique}
                categorie={d.categorie}
                titre={d.titre}
                href={d.pageComplete ? `/article/${d.slug}/` : undefined}
                verdict={null}
                statutLibelle={d.pageComplete ? 'Lire l’analyse' : 'En cours de vérification'}
                meta={`${jd.total} sources et pièces`}
                illustration={d.illustration}
              />
            );
          })}
        </div>
      </section>
    )}
  </main>

  <footer class="accueil-pied">
    <div class="pied-texte">
      <strong>Une information plus récente ou une source plus solide ?</strong>
      <p>SeneSource corrige et met à jour ses articles lorsque de nouveaux éléments documentés l’exigent.</p>
      <a href="/methode">Voir notre méthode →</a>
    </div>
    <div class="pied-identite">
      <MarqueSeneSource format="pied" />
      <a class="pied-contact" href="mailto:contact@senesource.com">contact@senesource.com</a>
    </div>
  </footer>
</Base>

<style>
  .accueil {
    width: min(100%, 1200px);
    margin-inline: auto;
    padding: 18px 20px 56px;
  }
  .section-label {
    margin: 0 0 12px;
    font: 700 10px/1 var(--ss-font-mono);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ss-ink);
  }
  .une {
    padding-bottom: 34px;
    border-bottom: 1px solid var(--ss-ink);
  }
  .une-figure { margin: 0; }
  .une-media { position: relative; display: block; }
  .une-categorie {
    position: absolute;
    z-index: 2;
    top: 12px;
    left: 12px;
    padding: 8px 10px 7px;
    background: var(--ss-ink);
    color: var(--ss-paper);
    font: 700 9px/1 var(--ss-font-mono);
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  figcaption {
    margin-top: 7px;
    font: 400 10px/1.45 var(--ss-font-sans);
    color: var(--ss-mid);
  }
  .une-corps { padding-top: 18px; }
  h1 {
    max-width: 920px;
    margin: 0;
    font: 400 clamp(32px, 7vw, 62px)/1.02 var(--ss-font-serif);
    letter-spacing: -.035em;
    text-wrap: balance;
  }
  h1 a { color: var(--ss-ink); }
  .une-resume {
    max-width: 760px;
    margin: 16px 0 0;
    font: 400 17px/1.5 var(--ss-font-sans);
    color: var(--ss-mid);
  }
  .une-bas {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    margin-top: 20px;
  }
  .une-bas > span {
    font: 500 9.5px/1.4 var(--ss-font-mono);
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--ss-mid);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    background: var(--ss-ink);
    color: var(--ss-paper);
    font: 700 10px/1 var(--ss-font-mono);
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .cta:hover { opacity: .86; }
  .suite { padding-top: 36px; }
  .section-entete {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 18px;
  }
  .section-entete h2 {
    margin: 0;
    font: 400 28px/1 var(--ss-font-serif);
  }
  .section-entete span {
    display: none;
    font: 500 9px/1 var(--ss-font-mono);
    letter-spacing: .07em;
    text-transform: uppercase;
    color: var(--ss-mid);
  }
  .grille {
    display: grid;
    grid-template-columns: 1fr;
    gap: 26px;
  }
  .accueil-pied {
    width: min(100% - 40px, 1200px);
    margin: 0 auto;
    padding: 28px 0 34px;
    border-top: 1px solid var(--ss-ink);
  }
  .pied-texte { max-width: 680px; margin-bottom: 28px; }
  .pied-texte strong { font: 500 21px/1.15 var(--ss-font-serif); }
  .pied-texte p { margin: 8px 0; color: var(--ss-mid); font: 400 14px/1.55 var(--ss-font-sans); }
  .pied-texte a { font: 600 10px/1 var(--ss-font-mono); text-transform: uppercase; letter-spacing: .06em; }
  .pied-identite { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px 20px; }
  .pied-contact { font: 500 10px/1.4 var(--ss-font-mono); letter-spacing: .06em; color: var(--ss-ink-60); }
  .pied-contact:hover { color: var(--ss-ochre); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  @media (min-width: 720px) {
    .une-bas { flex-direction: row; justify-content: space-between; align-items: center; }
    .section-entete span { display: block; }
    .grille { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .accueil { padding: 28px 48px 72px; }
    .grille { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .accueil-pied { width: min(calc(100% - 96px), 1200px); }
  }
</style>
