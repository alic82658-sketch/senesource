---
import Base from '../layouts/Base.astro';
import EnTete from '../components/layout/EnTete.astro';
import PiedDeSite from '../components/layout/PiedDeSite.astro';
import { AUTEUR, SITE_CONTACT } from '../lib/jsonld';

/**
 * /qui-sommes-nous — identité éditoriale de SeneSource.
 * Réutilise à l'identique le gabarit et les classes de /methode (même
 * structure, même feuille de style). Aucune valeur visuelle inventée.
 */
---

<Base
  titre="Qui sommes-nous"
  description="Qui édite SeneSource, qui répond de ses contenus, sa mission et son contact."
>
  <EnTete />

  <main class="methode">
    <header class="methode-tete">
      <span class="typo-label">Qui sommes-nous</span>
      <h1 class="typo-display methode-titre">Qui sommes-nous</h1>
      <p class="methode-promesse">Ce qui est dit. Ce qui est prouvé. Ce que ça change.</p>
      <p class="methode-intro">
        SeneSource est un projet citoyen de documentation de l’information au Sénégal. Nous
        confrontons les affirmations publiques aux textes, aux chiffres et aux documents, et nous
        en expliquons les conséquences concrètes.
      </p>
    </header>

    <!-- A -->
    <section class="section">
      <span class="typo-label">A</span>
      <h2 class="section-titre">Qui édite SeneSource</h2>
      <p class="section-texte">
        SeneSource est un média numérique indépendant de vérification documentaire, édité au
        Sénégal. Son contenu est produit selon une méthode publique&nbsp;: hiérarchie des sources,
        vocabulaire de la preuve, corrections datées et assumées.
      </p>
      <p class="section-texte">
        <a href="/methode">Lire notre méthode →</a>
      </p>
    </section>

    <!-- B -->
    <section class="section">
      <span class="typo-label">B</span>
      <h2 class="section-titre">Qui répond des contenus</h2>
      <p class="section-texte">
        La responsabilité éditoriale des contenus publiés est assurée par {AUTEUR}, directeur de la
        publication. C’est lui qui répond des articles et à qui s’adressent les demandes de
        correction ou de droit de réponse.
      </p>
    </section>

    <!-- C -->
    <section class="section">
      <span class="typo-label">C</span>
      <h2 class="section-titre">Notre mission</h2>
      <ul class="liste">
        <li class="liste-item">Établir les faits d’intérêt public à partir des meilleures sources disponibles.</li>
        <li class="liste-item">Montrer les preuves et distinguer clairement ce qui est établi de ce qui ne l’est pas.</li>
        <li class="liste-item">Expliquer les conséquences concrètes des décisions publiques.</li>
      </ul>
    </section>

    <!-- D -->
    <section class="section">
      <span class="typo-label">D</span>
      <h2 class="section-titre">Nous écrire</h2>
      <p class="section-texte">
        Une information à faire vérifier, une correction, une source&nbsp;: écrivez-nous à
        <a href={`mailto:${SITE_CONTACT}`}>{SITE_CONTACT}</a>.
      </p>
      <p class="section-texte section-texte--note">
        Voir aussi nos <a href="/mentions-legales">mentions légales</a>.
      </p>
    </section>
  </main>

  <PiedDeSite />
</Base>

<style>
  .methode {
    padding: 22px 20px 8px;
    max-width: var(--ss-texte-max);
  }

  /* ---- Tête ---- */
  .methode-titre {
    margin-top: 12px;
  }
  .methode-promesse {
    margin-top: 14px;
    font: 400 17px/1.4 var(--ss-font-serif);
    font-style: italic;
    color: var(--ss-ink);
  }
  .methode-intro {
    margin-top: 14px;
    font: 400 15.5px/1.62 var(--ss-font-sans);
    color: var(--ss-ink-80);
    max-width: var(--ss-corps-max);
    text-wrap: pretty;
  }

  /* ---- Sections ---- */
  .section {
    margin-top: 26px;
    padding-top: 20px;
    border-top: 1px solid var(--ss-ink); /* filet fort entre sections */
  }
  .section-titre {
    margin-top: 8px;
    font: 400 21px/1.25 var(--ss-font-serif);
    letter-spacing: -0.01em;
    color: var(--ss-ink);
  }
  .section-texte {
    margin-top: 12px;
    font: 400 15px/1.62 var(--ss-font-sans);
    color: var(--ss-ink-80);
    max-width: var(--ss-corps-max);
    text-wrap: pretty;
  }
  .section-texte--note {
    margin-top: 14px;
    color: var(--ss-ink-60);
  }

  /* ---- Listes ---- */
  .liste {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    max-width: var(--ss-corps-max);
  }
  .liste-item {
    position: relative;
    padding: 8px 0 8px 22px;
    border-top: 1px solid var(--ss-rule); /* filet fin : items d'un même niveau */
    font: 400 14.5px/1.5 var(--ss-font-sans);
    color: var(--ss-ink-80);
    counter-increment: liste;
  }
  /* Puce mono ocre — cohérente avec le renvoi [n] du design system */
  .liste-item::before {
    content: '—';
    position: absolute;
    left: 0;
    font: 400 12px/1.7 var(--ss-font-mono);
    color: var(--ss-ochre);
  }
  .liste--ordonnee {
    counter-reset: liste;
  }
  .liste--ordonnee .liste-item::before {
    content: counter(liste);
  }

  /* ---- Vocabulaire de la preuve (B) ---- */
  .etats {
    margin: 14px 0 0;
    max-width: var(--ss-corps-max);
  }
  .etat {
    padding: 10px 0;
    border-top: 1px solid var(--ss-rule);
  }
  .etat-mot {
    font: 500 10px/1 var(--ss-font-mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ss-ink);
  }
  .etat-sens {
    margin: 6px 0 0;
    font: 400 14.5px/1.5 var(--ss-font-sans);
    color: var(--ss-ink-60);
  }

  /* ---- Principe (D) ---- */
  .principe {
    margin-top: 12px;
    font: 400 22px/1.35 var(--ss-font-serif);
    font-style: italic;
    color: var(--ss-ink);
    max-width: 26ch;
  }

  /* =============== ≥1024 =============== */
  @media (min-width: 1024px) {
    .methode {
      padding: 34px 48px 12px;
    }
    .methode-promesse {
      font-size: 19px;
    }
    .methode-intro {
      font-size: 16.5px;
      line-height: 1.65;
    }
    .section {
      margin-top: 32px;
      padding-top: 24px;
    }
    .section-titre {
      font-size: 23px;
    }
    .section-texte {
      font-size: 16px;
      line-height: 1.65;
    }
    .liste-item {
      font-size: 15px;
    }
    .etat-sens {
      font-size: 15px;
    }
    .principe {
      font-size: 26px;
    }
  }
  @media (min-width: 1440px) {
    .methode {
      padding-left: 64px;
      padding-right: 64px;
    }
  }
</style>
