# Studio SeneSource — configuration du projet Sanity.
# Le projectId n'est pas un secret (exposé dans le bundle client).
# Copier en `.env` pour surcharger les valeurs par défaut du code.

SANITY_STUDIO_PROJECT_ID=oug8iag3
SANITY_STUDIO_DATASET=production

# Authentification (JAMAIS committée) — nécessaire pour déployer les schémas,
# lancer le Studio contre le vrai dataset et écrire des documents.
# Obtenue via `sanity login`, ou un jeton créé sur https://sanity.io/manage.
# SANITY_AUTH_TOKEN=
